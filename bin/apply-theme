#!/usr/bin/env python3
"""Apply or restore the Synthwave '84 [theme] block in Herdr's config.toml."""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PLUGIN_ROOT = Path(os.environ.get("HERDR_PLUGIN_ROOT", Path(__file__).resolve().parent.parent))
THEME_FILE = PLUGIN_ROOT / "themes" / "synthwave-84.toml"
BACKUP_NAME = "theme-backup.toml"
MANAGED_BY = "# Managed by Herdr plugin: herdr-theme-synthwave-84"
# Present in the backup when the config had no [theme] tables before the first apply.
NO_THEME_MARKER = "# herdr-theme-synthwave-84: no previous theme\n"

HEADER_RE = re.compile(r"^\s*(\[\[?)\s*([^\]]+?)\s*\]\]?\s*(#.*)?$")


def is_theme_header(line):
    """Return True for a [theme] or [theme.<sub>] table header, None for a non-header line."""
    match = HEADER_RE.match(line)
    if not match:
        return None
    brackets, name = match.group(1), match.group(2)
    if brackets == "[[":
        return False
    return name == "theme" or name.startswith("theme.")


def split_theme_tables(config):
    """Split config text into (rest, theme, insert_at).

    `theme` holds every [theme] / [theme.*] table, `rest` holds everything else,
    and `insert_at` is the character offset in `rest` where the first theme table
    sat, or None when the config has no theme table.
    """
    rest, theme = [], []
    insert_at = None
    in_theme = False
    for line in config.splitlines(keepends=True):
        header = is_theme_header(line)
        if header is not None:
            in_theme = header
            if header and insert_at is None:
                insert_at = sum(len(part) for part in rest)
        (theme if in_theme else rest).append(line)
    return "".join(rest), "".join(theme), insert_at


def replace_theme_tables(config, block):
    """Return config with its theme tables swapped for `block`."""
    rest, _, insert_at = split_theme_tables(config)
    if insert_at is None:
        if not block:
            return rest
        if rest and not rest.endswith("\n"):
            rest += "\n"
        separator = "\n" if rest and not rest.endswith("\n\n") else ""
        return rest + separator + block
    before, after = rest[:insert_at], rest[insert_at:]
    if block and after and not block.endswith("\n\n"):
        block = block.rstrip("\n") + "\n\n"
    return before + block + after


def remove_appended_block(config):
    """Remove the theme tables plus the blank separator line added when they were appended."""
    rest = replace_theme_tables(config, "")
    if rest.endswith("\n\n"):
        rest = rest[:-1]
    return rest


def theme_block():
    """Return the bundled theme, starting at its first table header."""
    lines = THEME_FILE.read_text().splitlines(keepends=True)
    for index, line in enumerate(lines):
        if is_theme_header(line):
            return "".join(lines[index:])
    raise SystemExit(f"no [theme] table in {THEME_FILE}")


def config_path():
    explicit = os.environ.get("HERDR_CONFIG_PATH")
    if explicit:
        return Path(explicit).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / "herdr" / "config.toml"


def state_dir():
    directory = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    path = Path(directory) if directory else PLUGIN_ROOT / ".state"
    path.mkdir(parents=True, exist_ok=True)
    return path


def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".config.", suffix=".toml")
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    if path.exists():
        os.chmod(tmp, path.stat().st_mode & 0o777)
    os.replace(tmp, path)


def herdr(*args):
    binary = os.environ.get("HERDR_BIN_PATH") or "herdr"
    return subprocess.run([binary, *args], capture_output=True, text=True)


def commit(path, old, new):
    """Write `new`, validate it with Herdr, and roll back to `old` when invalid."""
    write_atomic(path, new)
    check = herdr("config", "check")
    if check.returncode != 0:
        write_atomic(path, old)
        sys.stderr.write(check.stdout + check.stderr)
        raise SystemExit("herdr config check failed; config.toml left unchanged")
    reload = herdr("server", "reload-config")
    if reload.returncode != 0:
        print("config.toml updated; Herdr server not reloaded (is it running?)")


def apply(path):
    old = path.read_text() if path.exists() else ""
    backup = state_dir() / BACKUP_NAME
    _, theme, insert_at = split_theme_tables(old)
    # A theme carrying the marker is this plugin's own output; backing it up
    # would make restore reinstate Synthwave '84.
    first_apply = not backup.exists() and MANAGED_BY not in theme
    if first_apply:
        backup.write_text(NO_THEME_MARKER if insert_at is None else theme)
    try:
        commit(path, old, replace_theme_tables(old, theme_block()))
    except SystemExit:
        if first_apply:
            backup.unlink()
        raise
    print("Synthwave '84 applied")


def restore(path):
    backup = state_dir() / BACKUP_NAME
    if not backup.exists():
        raise SystemExit("no backup found; nothing to restore")
    old = path.read_text() if path.exists() else ""
    saved = backup.read_text()
    if saved == NO_THEME_MARKER:
        new = remove_appended_block(old)
    else:
        new = replace_theme_tables(old, saved)
    commit(path, old, new)
    backup.unlink()
    print("previous theme restored")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--restore", action="store_true")
    args = parser.parse_args()
    path = config_path()
    if args.apply:
        apply(path)
    else:
        restore(path)


if __name__ == "__main__":
    main()
